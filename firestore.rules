rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Estar autenticado NO basta: la apiKey viaja en el bundle público, así que
    // cualquiera puede crearse una cuenta si el alta está abierta. Lo que da
    // acceso es el custom claim `admin`, que solo se pone desde el Admin SDK:
    //   npm run admin:claim prod -- --grant correo@ejemplo.com
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Público: cualquiera puede crear solicitudes de reserva, con forma y límites estrictos
    match /reservas/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
          'productoId', 'productoNombre', 'seccion', 'cliente', 'localizador',
          'cantidad', 'notas', 'fecha', 'estado'
        ])
        && request.resource.data.keys().hasAll([
          'productoId', 'productoNombre', 'seccion', 'cliente', 'localizador',
          'cantidad', 'notas', 'fecha', 'estado'
        ])
        && request.resource.data.productoId is string && request.resource.data.productoId.size() > 0 && request.resource.data.productoId.size() <= 200
        && request.resource.data.productoNombre is string && request.resource.data.productoNombre.size() <= 200
        && request.resource.data.seccion is string && request.resource.data.seccion.size() <= 200
        && request.resource.data.cliente is string && request.resource.data.cliente.size() > 0 && request.resource.data.cliente.size() <= 200
        && request.resource.data.cliente.matches('^\\S+(\\s+\\S+)+$')
        // Localizador con el formato exacto que emite lib/localizador: dos
        // bloques de cuatro sin los caracteres que se confunden (0/O, 1/I/L).
        && request.resource.data.localizador is string
        && request.resource.data.localizador.matches('^[23456789A-HJKMNP-Z]{4}-[23456789A-HJKMNP-Z]{4}$')
        && request.resource.data.cantidad is int && request.resource.data.cantidad > 0 && request.resource.data.cantidad <= 100
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 1000
        && request.resource.data.fecha == request.time
        && request.resource.data.estado == 'pendiente';
      allow read, update, delete: if isAdmin();
    }

    // Público: catálogo, navegación y torneos son de solo lectura para cualquiera
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tcg_categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /nav_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /torneosJuegos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resto: solo el admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
